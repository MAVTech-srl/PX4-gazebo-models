<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_lidar_3d'>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_covariance_topic>/mavros/local_position/odom</odom_covariance_topic>
      <gaussian_noise>0.01</gaussian_noise>
    </plugin>
    
    <plugin
      filename="gz-sim-forcetorque-system"
      name="gz::sim::systems::ForceTorque">
    </plugin>

    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include merge='true'>
      <uri>model://lidar_3d</uri>
      <!-- <pose>.12 0 .26 0 0 0</pose> -->
      <pose>0 0 0.26 0 0 0</pose>
    </include>
    <joint name="LidarJoint" type="fixed">
      <parent>base_link</parent>
      <child>link</child>
      <!-- <pose relative_to="base_link">-.1 0 .26 0 0 0</pose> -->
      <pose relative_to="base_link">-0 0 0.26 0 0 0</pose>
    </joint>
  </model>
</sdf>
