	      <max>200.0</max>
	      <resolution>0.02</resolution>
	    </range>
	    <noise>
	      <type>gaussian</type>
	      <mean>0.0</mean>
	      <stddev>0.02</stddev>
	    </noise>
	  </ray>
	  <always_on>1</always_on>
	  <update_rate>15</update_rate>
	  <visualize>true</visualize>
